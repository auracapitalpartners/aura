---
import '../styles/global.css';
const services = [
  {
    number: '01',
    title: 'Gestión financiera',
    description: 'Más claridad sobre los ingresos, gastos y decisiones de tu negocio.',
    items: ['Flujo de caja y presupuestos', 'Costos y márgenes', 'Indicadores de gestión']
  },
  {
    number: '02',
    title: 'Diseño web',
    description: 'Una presencia profesional para explicar lo que haces y generar confianza.',
    items: ['Sitios web corporativos', 'Landing pages', 'Formularios de contacto']
  },
  {
    number: '03',
    title: 'Presencia digital',
    description: 'Herramientas sencillas para mostrar tus servicios y facilitar el contacto.',
    items: ['Catálogos digitales', 'Integración con WhatsApp', 'Organización de tu oferta']
  }
];
const whatsappNumber = ''; // Agrega aquí el número con código de país, solo dígitos. Ej.: 56912345678
const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola, quisiera conocer los servicios de Aura Capital Partners.')}`
  : '#contacto';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111214" />
    <meta name="description" content="Aura Capital Partners acompaña a emprendedores y pequeños negocios con gestión financiera, diseño web y soluciones de presencia digital." />
    <title>Aura Capital Partners | Claridad para decidir. Estrategia para crecer.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Aura Capital Partners, inicio">
        <span class="brand-name">AURA</span>
        <span class="brand-subtitle">CAPITAL PARTNERS</span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#inicio">Inicio</a>
        <a href="#servicios">Servicios</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cta" href={whatsappUrl}>Conversemos <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <section class="hero section-wrap" id="inicio">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> FINANZAS · ESTRATEGIA · PRESENCIA DIGITAL</p>
          <h1>Claridad para decidir.<br /><span>Estrategia para crecer.</span></h1>
          <p class="hero-description">Acompañamos a emprendedores y pequeños negocios con soluciones financieras y digitales para gestionar mejor, proyectarse profesionalmente y avanzar con mayor claridad.</p>
          <div class="hero-actions">
            <a class="button button-gold" href="#servicios">Conoce nuestros servicios <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#contacto">Hablemos <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-note"><span class="status-dot"></span> Soluciones pensadas para negocios reales.</div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="art-orbit orbit-three"></div>
          <div class="art-core"><span>A</span></div>
          <div class="art-caption"><span class="caption-line"></span><span>Una visión más clara<br />para tu negocio</span></div>
          <div class="art-coordinate coordinate-top">AC / 01</div>
          <div class="art-coordinate coordinate-bottom">EST. WITH INTENTION</div>
        </div>
      </section>

      <section class="intro-band">
        <div class="section-wrap intro-inner">
          <p class="eyebrow">UNA MIRADA INTEGRAL</p>
          <p class="intro-statement">Tu negocio necesita números claros y una presencia que esté a la altura de lo que ofreces.</p>
          <p class="intro-detail">Unimos gestión financiera y soluciones digitales prácticas para ayudarte a ordenar, comunicar y avanzar.</p>
        </div>
      </section>

      <section class="services section-wrap" id="servicios">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> CÓMO PODEMOS AYUDAR</p>
            <h2>Soluciones prácticas.<br /><span>Decisiones más claras.</span></h2>
          </div>
          <p class="heading-aside">Nos enfocamos en lo que tu negocio necesita hoy, con herramientas que puedan crecer contigo.</p>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <div class="card-top"><span class="service-number">{service.number}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
              <h3>{service.title}</h3>
              <p class="service-description">{service.description}</p>
              <ul>{service.items.map((item) => <li>{item}</li>)}</ul>
              <a class="card-link" href="#contacto">Conversemos sobre esto <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="approach" id="nosotros">
        <div class="section-wrap approach-grid">
          <div class="approach-title">
            <p class="eyebrow"><span class="eyebrow-line"></span> NUESTRA FORMA DE TRABAJAR</p>
            <h2>Simple, claro y<br /><span>orientado a tu negocio.</span></h2>
            <p>No necesitas más complejidad. Necesitas entender tus prioridades y contar con un plan concreto para abordarlas.</p>
          </div>
          <div class="steps">
            <div class="step"><span>01</span><div><h3>Conversamos</h3><p>Entendemos tu negocio, tus objetivos y el desafío que quieres resolver.</p></div></div>
            <div class="step"><span>02</span><div><h3>Definimos prioridades</h3><p>Identificamos necesidades y acordamos un alcance claro para el trabajo.</p></div></div>
            <div class="step"><span>03</span><div><h3>Proponemos una solución</h3><p>Recibes una propuesta concreta, con etapas y condiciones transparentes.</p></div></div>
            <div class="step"><span>04</span><div><h3>Implementamos</h3><p>Avanzamos con foco y revisamos los siguientes pasos según tus necesidades.</p></div></div>
          </div>
        </div>
      </section>

      <section class="contact section-wrap" id="contacto">
        <div class="contact-panel">
          <div class="contact-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span> HABLEMOS DE TU NEGOCIO</p>
            <h2>Tu próximo paso<br /><span>empieza con una conversación.</span></h2>
            <p>Cuéntanos qué te gustaría ordenar, mejorar o poner en marcha. Evaluemos juntos cuál puede ser el siguiente paso.</p>
          </div>
          <div class="contact-actions">
            <a class="button button-gold" href={whatsappUrl}>Contactar a Aura <span aria-hidden="true">↗</span></a>
            <p>Una primera conversación, sin complicaciones.</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand footer-brand" href="#inicio"><span class="brand-name">AURA</span><span class="brand-subtitle">CAPITAL PARTNERS</span></a>
      <p>Claridad financiera. Presencia digital profesional.</p>
      <span class="copyright">© {new Date().getFullYear()} Aura Capital Partners</span>
    </footer>
  </body>
</html>
